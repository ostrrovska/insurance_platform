#   policy.status  = ACTIVE
#   payment.status = COMPLETED
###############################################################################

### 7.1 successfull saga (simulate_payment_failure: false)
POST http://localhost:8005/api/v1/sagas/policy-purchase
Content-Type: application/json

{
  "customer_id": 1,
  "policy_type": "HEALTH",
  "coverage_amount": 200000.00,
  "premium_amount": 2400.00,
  "simulate_payment_failure": false
}

###

GET http://localhost:8005/api/v1/sagas/6967f7d4-0aa9-4ed4-83db-d8f7d59ec98f

###

GET http://localhost:8005/api/v1/sagas/

###

GET http://localhost:8002/api/v1/policies/

###

GET http://localhost:8003/api/v1/payments/

###


###############################################################################
#partial saga/failed payment
#   saga.status    = COMPENSATED   <- компенсація виконана
#   policy.status  = CANCELLED     <- компенсуюча транзакція
#   payment.status = FAILED        <- платіж не пройшов
###############################################################################

POST http://localhost:8005/api/v1/sagas/policy-purchase
Content-Type: application/json

{
  "customer_id": 1,
  "policy_type": "LIFE",
  "coverage_amount": 500000.00,
  "premium_amount": 5000.00,
  "simulate_payment_failure": true
}

###

#   status = "COMPENSATED"
#   error  = "Payment failed (HTTP 402): ..."
#   steps_log: ... -> COMPENSATING -> CANCEL_POLICY -> COMPENSATED
GET http://localhost:8005/api/v1/sagas/d4cc4591-89f9-43c7-87ce-b281a9a2d5b1

###

GET http://localhost:8005/api/v1/sagas/

###

GET http://localhost:8002/api/v1/policies/

###

GET http://localhost:8003/api/v1/payments/

###


