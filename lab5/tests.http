###############################################################################
# КРОК 6 — Підготовка: Створити клієнта (напряму або через Gateway)
###############################################################################

### 6.1 Створити ще одного клієнта для саги (через Gateway)
POST http://localhost:8000/api/v1/customers/
Content-Type: application/json

{
  "name": "Олег Іваненко",
  "email": "oleg.ivanenko@example.com"
}

###

### 6.2 Список всіх клієнтів
GET http://localhost:8000/api/v1/customers/

###


###############################################################################
# КРОК 7 — СЦЕНАРІЙ САГИ 1: УСПІШНЕ ЗАВЕРШЕННЯ
#
# Очікуваний результат:
#   saga.status    = COMPLETED
#   policy.status  = ACTIVE
#   payment.status = COMPLETED
###############################################################################

### 7.1 Запустити успішну сагу (simulate_payment_failure: false)
POST http://localhost:8005/api/v1/sagas/policy-purchase
Content-Type: application/json

{
  "customer_id": 1,
  "policy_type": "HEALTH",
  "coverage_amount": 200000.00,
  "premium_amount": 2400.00,
  "simulate_payment_failure": false
}

###

### 7.2 Перевірити статус саги
# Підстав saga_id з відповіді 7.1
# Через ~1 сек має бути status=COMPLETED
# steps_log покаже: STARTED -> VALIDATING_CUSTOMER -> CREATING_POLICY
#                   -> PROCESSING_PAYMENT -> ACTIVATING_POLICY -> COMPLETED
GET http://localhost:8005/api/v1/sagas/SAGA_ID_FROM_7_1

###

### 7.3 Перевірити поліс (status = ACTIVE)
GET http://localhost:8005/api/v1/sagas/

###

### 7.4 Всі поліси — має бути ACTIVE
GET http://localhost:8002/api/v1/policies/

###

### 7.5 Всі платежі — має бути COMPLETED
GET http://localhost:8003/api/v1/payments/

###


###############################################################################
# КРОК 8 — СЦЕНАРІЙ САГИ 2: ПОМИЛКА + АВТОМАТИЧНА КОМПЕНСАЦІЯ
#
# Очікуваний результат:
#   saga.status    = COMPENSATED   <- компенсація виконана
#   policy.status  = CANCELLED     <- компенсуюча транзакція
#   payment.status = FAILED        <- платіж не пройшов
###############################################################################

### 8.1 Запустити сагу з simulate_payment_failure: true
POST http://localhost:8005/api/v1/sagas/policy-purchase
Content-Type: application/json

{
  "customer_id": 1,
  "policy_type": "LIFE",
  "coverage_amount": 500000.00,
  "premium_amount": 5000.00,
  "simulate_payment_failure": true
}

###

### 8.2 Перевірити статус саги
# Підстав saga_id з відповіді 8.1
# Очікуємо:
#   status = "COMPENSATED"
#   error  = "Payment failed (HTTP 402): ..."
#   steps_log: ... -> COMPENSATING -> CANCEL_POLICY -> COMPENSATED
GET http://localhost:8005/api/v1/sagas/SAGA_ID_FROM_8_1

###

### 8.3 Всі саги — COMPLETED та COMPENSATED
GET http://localhost:8005/api/v1/sagas/

###

### 8.4 КЛЮЧОВА ПЕРЕВІРКА: поліс з компенсованої саги має статус CANCELLED
GET http://localhost:8002/api/v1/policies/

###

### 8.5 Всі платежі — COMPLETED і FAILED
GET http://localhost:8003/api/v1/payments/

###


###############################################################################
# КРОК 9 — ДАШБОРД ПІСЛЯ ОБОХ САГ (підсумкова перевірка узгодженості)
#
# Після виконання сценаріїв 7 і 8:
#   Поліс 1 (AUTO)   — ACTIVE
#   Поліс 2 (HEALTH) — ACTIVE    (з сценарію 7)
#   Поліс 3 (LIFE)   — CANCELLED (з сценарію 8, компенсовано)
#   Платіж 1 — COMPLETED
#   Платіж 2 — COMPLETED
#   Платіж 3 — FAILED
###############################################################################

### 9.1 Дашборд клієнта — перевірити фінальний стан всіх даних
# Composition endpoint бере дані паралельно з 3 сервісів і агрегує
GET http://localhost:8000/api/v1/composition/customer/1/dashboard

###

### 9.2 Notifications — побачимо всі події з обох саг
# PolicyActivated (x2) і PolicyCancelled (x1) — підтвердження узгодженості
GET http://localhost:8000/api/v1/notifications

###


###############################################################################
# ПЕРЕВІРКА ДАНИХ У БД
# SQL для psql / DBeaver / DataGrip / TablePlus
#
# policy_db (localhost:5439, user/password):
#   SELECT id, policy_type, status, coverage_amount FROM policies ORDER BY id;
#   Очікування після всіх сценаріїв:
#     id=1  AUTO   ACTIVE    (сага з кроку 2.3)
#     id=2  HEALTH ACTIVE    (сага з кроку 7.1)
#     id=3  LIFE   CANCELLED (сага з кроку 8.1, компенсована)
#
# payment_db (localhost:5440, user/password):
#   SELECT id, policy_id, amount, status FROM payments ORDER BY id;
#   id=1  1800  COMPLETED
#   id=2  2400  COMPLETED
#   id=3  5000  FAILED
#
# orchestrator_db (localhost:5442, user/password):
#   SELECT id, status, policy_id, payment_id, error FROM sagas ORDER BY created_at;
#   SELECT id, steps_log FROM sagas WHERE status='COMPENSATED';
###############################################################################


