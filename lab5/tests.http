# ── policy_db (localhost:5439, user/password) ────────────────────────────────

#   docker exec -it lab5_policy_db psql -U user -d policy_db -c \
#     "SELECT id, policy_type, status, coverage_amount FROM policies ORDER BY id;"
#
# ── payment_db (localhost:5440, user/password) ───────────────────────────────

#   docker exec -it lab5_payment_db psql -U user -d payment_db -c \
#     "SELECT id, policy_id, amount, status FROM payments ORDER BY id;"
#
# ── orchestrator_db (localhost:5442, user/password) ──────────────────────────

#   docker exec -it lab5_orchestrator_db psql -U user -d orchestrator_db -c \
#     "SELECT id, status, policy_id, payment_id, error FROM sagas ORDER BY created_at;"
#
#   docker exec -it lab5_orchestrator_db psql -U user -d orchestrator_db -c \
#     "SELECT id, steps_log FROM sagas WHERE status='COMPENSATED';"
#
# ── customer_db (localhost:5438, user/password) ───────────────────────────────

#   docker exec -it lab5_customer_db psql -U user -d customer_db -c \
#     "SELECT id, name, email FROM customers ORDER BY id;"
#
# ── notification_db (localhost:5441, user/password) ──────────────────────────

#   docker exec -it lab5_notification_db psql -U user -d notification_db -c \
#     "SELECT id, event_type, routing_key, created_at FROM notifications ORDER BY id;"
