###############################################################################
# LAB 5 + LAB 6 — Saga Pattern + API Gateway + API Composition
# Insurance Platform
#
# ЗАПУСК: cd lab5 && docker compose up --build
# Чекай ~40 сек поки всі контейнери стартують.
#
# ПОРТИ:
#   8000 — api_gateway        (LAB 6) <- єдина точка входу для клієнтів
#   8001 — customer_service   (внутрішній)
#   8002 — policy_service     (внутрішній)
#   8003 — payment_service    (внутрішній)
#   8004 — notification_service (внутрішній)
#   8005 — saga_orchestrator  (LAB 5)
#
# В реальній системі клієнти використовують ТІЛЬКИ порт 8000 (API Gateway).
# Внутрішні порти 8001-8005 залишаються відкритими тільки для демонстрації.
#
# БД (для прямої перевірки):
#   5438 — customer_db     (user / password)
#   5439 — policy_db       (user / password)
#   5440 — payment_db      (user / password)
#   5441 — notification_db (user / password)
#   5442 — orchestrator_db (user / password)
###############################################################################


###############################################################################
# ═══════════════════════════════════════════════════════════════════════════
#  ЧАСТИНА 1 — LAB 6: API GATEWAY + API COMPOSITION
# ═══════════════════════════════════════════════════════════════════════════
###############################################################################


###############################################################################
# КРОК 1 — Health checks через API Gateway (порт 8000)
###############################################################################

### 1.1 Health check самого Gateway
GET http://localhost:8000/health

###

### 1.2 Інформаційна сторінка Gateway (список маршрутів)
GET http://localhost:8000/

###


###############################################################################
# КРОК 2 — Routing: всі запити через Gateway (порт 8000)
# Gateway проксує запити до відповідних внутрішніх сервісів
###############################################################################

### 2.1 Створити клієнта ЧЕРЕЗ GATEWAY (Gateway -> customer_service:8001)
POST http://localhost:8000/api/v1/customers/
Content-Type: application/json

{
  "name": "Марія Коваленко",
  "email": "maria.kovalenko@example.com"
}

###

### 2.2 Список клієнтів ЧЕРЕЗ GATEWAY
GET http://localhost:8000/api/v1/customers/

###

### 2.3 Запустити сагу ЧЕРЕЗ GATEWAY (Gateway -> saga_orchestrator:8005)
# Підстав customer_id з кроку 2.1 (зазвичай 1)
POST http://localhost:8000/api/v1/sagas/policy-purchase
Content-Type: application/json

{
  "customer_id": 1,
  "policy_type": "AUTO",
  "coverage_amount": 150000.00,
  "premium_amount": 1800.00,
  "simulate_payment_failure": false
}

###

### 2.4 Статус саги ЧЕРЕЗ GATEWAY (Gateway -> saga_orchestrator:8005)
# Підстав saga_id з відповіді 2.3
GET http://localhost:8000/api/v1/sagas/SAGA_ID_FROM_2_3

###

### 2.5 Список полісів ЧЕРЕЗ GATEWAY (Gateway -> policy_service:8002)
GET http://localhost:8000/api/v1/policies/

###

### 2.6 Список платежів ЧЕРЕЗ GATEWAY (Gateway -> payment_service:8003)
GET http://localhost:8000/api/v1/payments/

###

### 2.7 Notifications ЧЕРЕЗ GATEWAY (Gateway -> notification_service:8004)
GET http://localhost:8000/api/v1/notifications

###


###############################################################################
# КРОК 3 — API COMPOSITION: успішна агрегація даних
#
# Бізнес-кейс: "Дашборд клієнта" — одним запитом отримуємо:
#   - Дані клієнта
#   - Всі його поліси
#   - Всі його платежі
#   - Зведену статистику (покриття, витрати)
#
# Gateway паралельно викликає customer_service + policy_service + payment_service
# і повертає злитий JSON. Замість 3 запитів від клієнта — 1.
###############################################################################

### 3.1 Дашборд клієнта — ПОВНА ВІДПОВІДЬ (всі сервіси доступні)
# Підстав customer_id з кроку 2.1 (зазвичай 1)
# Очікуємо:
#   status: "complete"
#   customer: {...}
#   policies: [...]
#   payments: [...]
#   summary: { active_policies, total_active_coverage, total_paid, ... }
#   errors: {}
GET http://localhost:8000/api/v1/composition/customer/1/dashboard

###

### 3.2 Деталі конкретного полісу (policy + customer + payment history)
# Підстав policy_id з відповіді 2.4 (зазвичай 1)
# Очікуємо:
#   status: "complete"
#   policy: {...}
#   customer: {...}
#   payments: [...]
#   payment_summary: { total_paid, completed_count, ... }
GET http://localhost:8000/api/v1/composition/policy/1/details

###

### 3.3 Дашборд клієнта якого немає — очікуємо 404
GET http://localhost:8000/api/v1/composition/customer/9999/dashboard

###


###############################################################################
# КРОК 4 — API COMPOSITION: ЧАСТКОВА ВІДПОВІДЬ при недоступності сервісу
#
# Демонстрація стійкості: якщо один з upstream-сервісів недоступний,
# Gateway повертає дані з тих сервісів, що відповіли (partial response).
#
# СЦЕНАРІЙ: зупинити payment_service і зробити запит до composition.
#
# Команда для зупинки:
#   docker compose stop payment_service
#
# Очікуємо:
#   status: "partial"
#   customer: {...}        <- отримано
#   policies: [...]        <- отримано
#   payments: null         <- payment_service недоступний
#   summary: { policies: ..., payments: "unavailable" }
#   errors: { "payment_service": "service unavailable (connection refused)" }
#
# Для відновлення:
#   docker compose start payment_service
###############################################################################

### 4.1 Дашборд із ЧАСТКОВИМИ ДАНИМИ (після зупинки payment_service)
# Виконай тільки після: docker compose stop payment_service
GET http://localhost:8000/api/v1/composition/customer/1/dashboard

###

### 4.2 Відновити payment_service і перевірити що все знову "complete"
# Виконай після: docker compose start payment_service
# (зачекай ~10 сек)
GET http://localhost:8000/api/v1/composition/customer/1/dashboard

###


###############################################################################
# КРОК 5 — Демонстрація Gateway routing з різними методами
###############################################################################

### 5.1 Отримати конкретного клієнта ЧЕРЕЗ GATEWAY
GET http://localhost:8000/api/v1/customers/1

###

### 5.2 Отримати конкретний поліс ЧЕРЕЗ GATEWAY
GET http://localhost:8000/api/v1/policies/1

###

### 5.3 Отримати конкретний платіж ЧЕРЕЗ GATEWAY
GET http://localhost:8000/api/v1/payments/1

###

### 5.4 Список полісів з фільтром по клієнту ЧЕРЕЗ GATEWAY
GET http://localhost:8000/api/v1/policies/?customer_id=1

###

### 5.5 Список платежів з фільтром по полісу ЧЕРЕЗ GATEWAY
GET http://localhost:8000/api/v1/payments/?policy_id=1

###

### 5.6 Спроба звернутися до невідомого сервісу — очікуємо 404 від Gateway
GET http://localhost:8000/api/v1/unknown-service/test

###


